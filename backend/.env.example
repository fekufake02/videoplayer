# Server Configuration
PORT=4000
NODE_ENV=development

# Database Configuration (MongoDB Atlas Connection String)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/videoplayer?retryWrites=true&w=majority

# Backblaze B2 Storage Configuration (S3 Compatible)
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
B2_BUCKET_NAME=my-private-video-bucket
B2_ACCESS_KEY_ID=your_b2_access_key_id
B2_SECRET_ACCESS_KEY=your_b2_secret_access_key

# Security & Sessions
SESSION_SECRET=super_secret_random_32_character_string_here
ADMIN_PASSWORD=change_this_to_your_secure_password

# CORS Configuration
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000
