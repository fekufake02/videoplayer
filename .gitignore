# ==========================================
# Comprehensive Git Ignore for Video Library
# ==========================================

# 1. Environment Files & Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.env
*.env.local
*.env.development
*.env.production
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# 2. Dependencies
node_modules/
**/node_modules/
.pnpm-store/

# 3. Build & Output Directories
dist/
**/dist/
.next/
**/.next/
out/
**/out/
build/
**/build/
.vercel/
.turbo/

# 4. TypeScript & Cache
*.tsbuildinfo
.cache/
.eslintcache

# 5. Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. Keys, Certificates & Credentials
*.pem
*.key
*.crt
*.p12
*.pfx
*.cer

# 7. OS & IDE System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 8. Testing & Coverage
coverage/
.nyc_output/
